{
  "job_id": "train-fixture",
  "run_name": "Fixture run",
  "spiral": {
    "api_url": "https://api.spiraldb.dev",
    "spfs_url": "https://spfs.spiraldb.dev",
    "project_id": "fixture-project",
    "namespace": "spiral_robotics",
    "client_id": "fixture-client",
    "client_secret": "fixture-secret"
  },
  "sql": "SELECT * FROM fixture",
  "state_column": "state",
  "action_column": "action",
  "spiral_schema_version": 9,
  "device": "cpu",
  "initialization": "random",
  "steps": 10,
  "batch_size": 2,
  "validation_split": 0.1,
  "learning_rate": 0.00001,
  "checkpoint_every": 5,
  "chunk_size": 4,
  "seed": 7,
  "act": {
    "camera_streams": [
      "observation.images.wrist"
    ],
    "image_width": 32,
    "image_height": 32,
    "video_decoder": "auto",
    "hidden_dimensions": 16,
    "latent_dimensions": 4,
    "attention_heads": 4,
    "feedforward_dimensions": 32,
    "encoder_layers": 1,
    "vae_encoder_layers": 1,
    "decoder_layers": 1,
    "kl_weight": 1.0
  }
}
