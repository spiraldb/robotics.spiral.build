{
  "job_id": "train-fixture",
  "spiral": {
    "api_url": "https://api.spiraldb.dev",
    "spfs_url": "https://spfs.spiraldb.dev",
    "project_id": "fixture-project",
    "table_prefix": "studio"
  },
  "spiral_schema_version": 12,
  "config": {
    "run_name": "fixture-run",
    "dataset_id": "fixture",
    "policy": "act",
    "sql": "SELECT * FROM fixture",
    "state_column": "state",
    "action_column": "action",
    "device": "cpu",
    "steps": 10,
    "batch_size": 2,
    "validation_split": 0.1,
    "learning_rate": 1e-05,
    "checkpoint_every": 5,
    "chunk_size": 4,
    "seed": 7,
    "act": {
      "camera_streams": [
        "observation.images.wrist"
      ],
      "image_width": 32,
      "image_height": 32,
      "video_decoder": "auto",
      "pretrained_backbone": false,
      "hidden_dim": 16,
      "latent_dim": 4,
      "encoder_layers": 1,
      "vae_encoder_layers": 1,
      "decoder_layers": 1,
      "attention_heads": 4,
      "feedforward_dim": 32,
      "kl_weight": 1.0
    }
  }
}
