<?xml version="1.0"?>
<!--
  SO-ARM101, described with primitive geometry.

  This is a visualization model, not a simulation model: it carries no inertia
  and no collision volumes, and its shells are boxes and cylinders rather than
  the printed meshes. What it does carry exactly is the kinematic chain — every
  joint name here is the motor name the rest of the studio uses, so measured
  joint angles drive this model without a translation table.

  Conventions follow the URDF standard: metres, radians, Z up, X forward. Each
  link extends along its own +Z, the flex joints turn about their own +Y, and
  the wrist rolls about the tool axis, which is +Z once the flexes are applied.

  Zero here is the mechanical zero — every joint centered, arm straight up. The
  pose that corresponds to a *calibrated* center is a separate question, and it
  is answered in code by `arm::SO101_REST_POSE`, not by these origins.
-->
<robot name="so_arm_101">

  <!--
    Neutral by default. The printed shells of a real SO-101 are pale grey and
    its brackets are dark, and keeping the model that way leaves colour free to
    mean something: the accent identifies which arm this is, and the jaw colour
    marks the one part that opens.
  -->
  <material name="shell">
    <color rgba="0.85 0.85 0.83 1.0"/>
  </material>
  <material name="frame">
    <color rgba="0.29 0.29 0.28 1.0"/>
  </material>
  <!-- Substituted per robot instance, so two arms in one scene stay apart. -->
  <material name="accent">
    <color rgba="0.29 0.56 0.85 1.0"/>
  </material>
  <material name="jaw">
    <color rgba="0.88 0.53 0.18 1.0"/>
  </material>

  <!-- Table plate the arm is bolted to. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.009" rpy="0 0 0"/>
      <geometry>
        <box size="0.100 0.100 0.018"/>
      </geometry>
      <material name="frame"/>
    </visual>
  </link>

  <joint name="shoulder_pan" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.018" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.92" upper="1.92" effort="10" velocity="3"/>
  </joint>

  <!-- Rotating turret carrying the shoulder-lift motor. -->
  <link name="shoulder_link">
    <visual>
      <origin xyz="0 0 0.0185" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.032" length="0.037"/>
      </geometry>
      <material name="accent"/>
    </visual>
  </link>

  <joint name="shoulder_lift" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.037" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.75" upper="1.75" effort="10" velocity="3"/>
  </joint>

  <!-- Shoulder pivot to elbow pivot: 117 mm. -->
  <link name="upper_arm_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.021" length="0.048"/>
      </geometry>
      <material name="accent"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.0585" rpy="0 0 0"/>
      <geometry>
        <box size="0.034 0.046 0.117"/>
      </geometry>
      <material name="shell"/>
    </visual>
  </link>

  <joint name="elbow_flex" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 0.117" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.7" upper="2.7" effort="10" velocity="3"/>
  </joint>

  <!-- Elbow pivot to wrist pivot: 135 mm. -->
  <link name="forearm_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.019" length="0.044"/>
      </geometry>
      <material name="accent"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.0675" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.040 0.135"/>
      </geometry>
      <material name="shell"/>
    </visual>
  </link>

  <joint name="wrist_flex" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_link"/>
    <origin xyz="0 0 0.135" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="10" velocity="3"/>
  </joint>

  <!-- Wrist pivot to the roll axis: 30 mm of the 75 mm to the tip. -->
  <link name="wrist_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.016" length="0.038"/>
      </geometry>
      <material name="accent"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.026 0.032 0.030"/>
      </geometry>
      <material name="shell"/>
    </visual>
  </link>

  <joint name="wrist_roll" type="revolute">
    <parent link="wrist_link"/>
    <child link="gripper_link"/>
    <origin xyz="0 0 0.030" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.8" upper="2.8" effort="10" velocity="3"/>
  </joint>

  <!--
    Gripper body plus the fixed jaw. The body is 45 mm long, putting the tip
    75 mm from the wrist pivot, and the fixed jaw sits on the -Y side so the
    moving jaw can close against it.
  -->
  <link name="gripper_link">
    <visual>
      <origin xyz="0 0 0.011" rpy="0 0 0"/>
      <geometry>
        <box size="0.024 0.050 0.022"/>
      </geometry>
      <material name="shell"/>
    </visual>
    <visual>
      <origin xyz="0 -0.0135 0.032" rpy="0 0 0"/>
      <geometry>
        <box size="0.014 0.009 0.045"/>
      </geometry>
      <material name="jaw"/>
    </visual>
  </link>

  <!--
    The moving jaw. Its pivot sits on the +Y side and closing swings it toward
    the fixed jaw, so the 45 mm span of a fully open SO-101 falls out of the
    jaw length rather than being drawn in by hand.
  -->
  <joint name="gripper" type="revolute">
    <parent link="gripper_link"/>
    <child link="gripper_jaw_link"/>
    <origin xyz="0 0.0135 0.022" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.52" effort="5" velocity="3"/>
  </joint>

  <link name="gripper_jaw_link">
    <visual>
      <origin xyz="0 0 0.0225" rpy="0 0 0"/>
      <geometry>
        <box size="0.014 0.009 0.045"/>
      </geometry>
      <material name="jaw"/>
    </visual>
  </link>

  <!--
    The point the arm is aimed at, 75 mm past the wrist pivot. It carries no
    shape: it exists so that "where is the tool" is answered by posing the
    description rather than by a length written down a second time in code.
  -->
  <joint name="tool_frame" type="fixed">
    <parent link="gripper_link"/>
    <child link="tool_link"/>
    <origin xyz="0 0 0.045" rpy="0 0 0"/>
  </joint>

  <link name="tool_link"/>

</robot>
